---
import Base from '../layouts/Base.astro';
---

<Base judul="Halaman tidak ditemukan">
  <section class="py-24">
    <div class="wadah grid gap-5 justify-items-start">
      <span class="stempel -rotate-6 !border-cap !text-cap">404</span>
      <h1>Halaman ini tidak ada di daftar</h1>
      <p class="text-pudar text-[1.1rem] max-w-[52ch]">Alamatnya mungkin salah ketik atau halamannya sudah dipindah.</p>
      <div class="flex flex-wrap gap-3.5">
        <a class="btn btn-utama" href="/">Kembali ke beranda</a>
        <a class="btn" href="/contoh-toko">Lihat contoh toko</a>
      </div>
    </div>
  </section>
</Base>
