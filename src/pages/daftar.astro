---
import Base from '../layouts/Base.astro';
import AuthForm from '../components/react/AuthForm';
---

<Base judul="Buka toko">
  <section class="gelap bg-tinta text-white py-16 md:py-24 min-h-[70vh]">
    <div class="wadah grid gap-10 lg:grid-cols-[5fr_6fr] items-start">
      <div class="grid gap-4">
        <h1 class="masuk" style="--i:0">Buka toko Anda sekarang</h1>
        <p class="masuk text-[#C9D1EE] text-[1.1rem] max-w-[46ch]" style="--i:1">Isi empat hal ini. Alamat toko Anda langsung terlihat saat mengetik nama.</p>
      </div>
      <div class="masuk" style="--i:2">
        <AuthForm mode="daftar" client:load />
      </div>
    </div>
  </section>
</Base>
